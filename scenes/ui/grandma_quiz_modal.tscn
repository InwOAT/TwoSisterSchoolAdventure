[node name="QuestionLabel" type="Label" parent="Panel/Margin/VBox/GrandmaCard/HBox/VBoxText"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.98, 1, 1)
theme_override_font_size = 13
text = "หลานเอ๊ย... ยายสายตาฝ้าฟาง กำลังจะไปหาหมอที่ 'โรงพยาบาลชุมชนหนองเรือ'
ช่วยยายดูหน่อยได้ไหมจ๊ะ ว่ายายต้องขึ้นรถสองแถวชานชาลาไหน และคันสีอะไร?"
