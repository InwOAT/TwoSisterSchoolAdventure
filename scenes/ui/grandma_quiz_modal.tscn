theme_override_font_size = 12
text = "📋 คำใบ้จากป้ายตารางเดินรถ: รถสีแดง = ตลาดสดเทศบาล | รถสีเขียว = โรงพยาบาลชุมชน | รถสีฟ้า = โรงเรียน"

